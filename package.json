{
  "name": "jalsuraksha-nepal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > types/database.types.ts",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "demo:users": "tsx --env-file-if-exists=.env.local scripts/create-demo-users.ts",
    "db:test": "supabase test db",
    "data:import": "tsx --env-file-if-exists=.env.local scripts/import-reference-data.ts",
    "routing:download": "mkdir -p routing/custom_files && curl -fL -A \"Mozilla/5.0 JalSuraksha\" -o routing/custom_files/nepal-latest.osm.pbf https://download.geofabrik.de/asia/nepal-latest.osm.pbf",
    "routing:up": "docker compose -f docker-compose.routing.yml up -d",
    "routing:down": "docker compose -f docker-compose.routing.yml down",
    "routing:logs": "docker logs -f jalsuraksha-valhalla"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
