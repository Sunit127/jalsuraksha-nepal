# ---------------------------------------------------------------------------
# JalSuraksha Nepal — environment variables
# Copy to .env.local for development. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API). Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# New "publishable" key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Secret key (sb_secret_...) or legacy service_role key.
# Used by /api/sos (guest SOS intake), uploads and demo tools. Never expose.
SUPABASE_SECRET_KEY=

# Presentation features: demo account buttons, scenario controls, simulated
# citizen location. Set to "false" for a real deployment.
NEXT_PUBLIC_DEMO_MODE=true

# SERVER ONLY. Shared password for the demo accounts created by
# `npm run demo:users` (citizen@, operator@, rescue@, admin@ demo.jalsuraksha.np).
DEMO_ACCOUNT_PASSWORD=

# SERVER ONLY. Future SMS fallback gateway shared secret. Leave empty to keep
# /api/sms/inbound disabled.
SMS_GATEWAY_SECRET=

# SERVER ONLY. Signs Supabase's "Send SMS" hook calls to /api/auth/send-sms.
# Locally: generate one with  echo "v1,whsec_$(openssl rand -base64 32)"  and put
# the SAME value in supabase/.env.local as SEND_SMS_HOOK_SECRET=... (read by
# supabase/config.toml). Hosted: generate one under Authentication → Hooks.
SEND_SMS_HOOK_SECRET=

# SERVER ONLY. Real SMS login codes via Twilio. Leave empty in development to
# get codes printed in the `npm run dev` terminal instead (never in production).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use ONE of these: a Messaging Service SID (MG...) or a sender number (+1...).
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# SERVER ONLY. Lets a scheduler (Vercel Cron / Supabase pg_cron) call
# /api/hydromet/sync as "Authorization: Bearer <CRON_SECRET>". Optional: pages
# also refresh DHM data lazily when it is older than 10 minutes.
CRON_SECRET=

# Self-hosted Valhalla routing service (see docs/REAL_DATA.md). Leave empty to
# use the built-in offline demo network.
VALHALLA_URL=

# Lock-screen flood alerts (Web Push). Generate a pair once with
#   npx web-push generate-vapid-keys
# Leave empty to disable push (the in-app siren still works).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SERVER ONLY.
VAPID_PRIVATE_KEY=
# Contact for push services: your site URL or mailto: address.
VAPID_SUBJECT=
